/* ArXiv Daily — 嵌套圆角矩形 · 底层暗、顶层亮
   层级：暖灰画布(最暗) → 顶栏/内容面板(次之) → 白色卡片(最亮) → 边线输入框
   全柔和灰阶，1px 细线，不用纯黑纯白 */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    outline: none;
}

QMainWindow, #rootPanel { background: #EFEFEC; }

/* ---- 第一层：悬浮胶囊顶栏（Linear/Notion 式） ---- */
#topCapsule {
    background: #FFFFFF;
    border: 1px solid #E4E4E1;
    border-radius: 28px;
}
#brandLabel { background: transparent; border: none; }
QLabel#navVersion { color: #ABABA6; font-size: 12px; font-weight: 400; }

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 14px;
    color: #8A8A86;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#navButton:hover { color: #2E2E2C; }
QPushButton#navButton:checked { color: #FDFDFC; }
#navIndicator { background: #333331; border-radius: 14px; }

/* 顶栏分段导航：无轨道底，白色滑动胶囊 + 细边线 */
#segmentBar { background: transparent; border: none; }
#segmentBar #navIndicator {
    background: #FFFFFF;
    border: 1px solid #E4E4E1;
    border-radius: 14px;
}
#segmentBar QPushButton#navButton:checked { color: #2E2E2C; font-weight: 600; }

/* ---- 极简月历（自主实现） ---- */
#calendarCard { background: #FFFFFF; border: 1px solid #E4E4E1; border-radius: 16px; }
QLabel#calTitle { font-size: 15px; font-weight: 600; color: #2E2E2C; }
#calWeekBar { background: #F5F5F2; border-radius: 10px; }
QLabel#calWeekday { color: #8A8A86; font-size: 11px; font-weight: 600; }
QPushButton#dateNavButton {
    background: #FFFFFF;
    border: 1px solid #D8D8D4; border-radius: 11px;
    padding: 0;
}
QPushButton#dateNavButton:hover { border-color: #ABABA6; }
QPushButton#dateNavButton:disabled { color: #B5B5B0; border-color: #E8E8E5; }
QPushButton#calNav {
    background: transparent; border: none; border-radius: 8px;
    color: #2E2E2C; font-size: 16px; font-weight: 600;
}
QPushButton#calNav:hover { background: #F1F1EF; }
QPushButton#calDay {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #2E2E2C; font-size: 13px;
}
QPushButton#calDay:hover { background: #F1F1EF; }
QPushButton#calDay:disabled { color: #CFCFC9; background: transparent; }
QPushButton#calDay[inRange="true"] { background: #ECECE8; }
QLabel#calHint { color: #55554F; font-size: 11px; font-weight: 500; }
QPushButton#calDay[hasData="true"] { font-weight: 700; }
QPushButton#calDay[isToday="true"] { border: 1px solid #333331; }
QPushButton#calDay[isSelected="true"] {
    background: #333331; color: #FDFDFC;
    border: none; font-weight: 700;
}

/* ---- 第一层：内容大面板（内嵌圆角矩形） ---- */
#contentPanel {
    background: #FAFAF9;
    border: 1px solid #E4E4E1;
    border-radius: 20px;
}

/* ---- 设置内壳（面板内再嵌一层白壳，承载侧栏与表单区） ---- */
#settingsShell {
    background: #FFFFFF;
    border: 1px solid #E4E4E1;
    border-radius: 16px;
}
#settingsSeparator { background: #EEEDEA; max-width: 1px; }

/* ---- 页面标题 ---- */
QLabel#pageTitle {
    font-size: 26px; font-weight: 300; color: #2E2E2C;
}
QLabel#pageSubtitle { font-size: 13px; color: #ABABA6; }
QLabel#watermark { font-size: 80px; font-weight: 300; color: #E7E7E3; }

/* ---- 搜索框 ---- */
QLineEdit#searchInput {
    background: #FFFFFF;
    border: 1px solid #DCDCD8;
    border-radius: 26px;
    padding: 13px 24px;
    font-size: 15px;
    color: #2E2E2C;
    selection-background-color: #333331;
    selection-color: #FDFDFC;
}
QLineEdit#searchInput:hover { border-color: #C9C9C4; }
QLineEdit#searchInput:focus { border: 1px solid #ABABA6; }
QPushButton#searchButton {
    background: #333331; color: #FDFDFC;
    border: none; border-radius: 26px;
    padding: 13px 34px; font-size: 14px; font-weight: 600;
}
QPushButton#searchButton:hover { background: #45453F; }
QPushButton#searchButton:pressed { background: #2A2A28; }
QPushButton#searchButton:disabled { background: #CFCFCB; }

/* ---- 状态 ---- */
QLabel#statusLabel { color: #8A8A86; font-size: 12px; }
QLabel#errorLabel {
    color: #B04A50; font-size: 13px;
    background: #FAF0F0; border: 1px solid #EFD8D8;
    border-radius: 14px; padding: 12px 16px;
}
QLabel#hintLabel { color: #8A8A86; font-size: 13px; }

/* ---- 第二层：论文卡片（白，最亮层） ---- */
PaperCard {
    background: #FFFFFF;
    border: 1px solid #E6E6E3;
    border-radius: 16px;
}
PaperCard:hover { border: 1px solid #C2C2BC; }
QLabel#cardTitle { font-size: 16px; font-weight: 500; color: #2E2E2C; }
QLabel#cardMeta { color: #ABABA6; font-size: 12px; }
QLabel#cardSummary { color: #55554F; font-size: 13px; }
QLabel#tagBubble {
    background: #F6F6F4; color: #5E5E59;
    border: 1px solid #E4E4E0; border-radius: 12px;
    padding: 2px 12px;
    font-size: 12px; font-weight: 500;
}
QPushButton#cardDownload {
    background: #333331; color: #FDFDFC;
    border: none; border-radius: 16px;
    padding: 7px 18px; font-size: 12px; font-weight: 600;
}
QPushButton#cardDownload:hover { background: #45453F; }
QPushButton#cardDownload:pressed { background: #2A2A28; }
QPushButton#cardDownload:disabled { background: #CFCFCB; }
QLabel#cardRank { color: #DEDEDA; font-size: 30px; font-weight: 300; }
QPushButton#starButton {
    background: transparent; border: none; border-radius: 12px;
    color: #B8B8B3; font-size: 18px; padding: 4px 8px;
}
QPushButton#starButton:hover { color: #2E2E2C; }
QPushButton#starButton:checked { color: #2E2E2C; }

/* ---- 日报主题 chips ---- */
QFrame#topicChip {
    background: #FFFFFF; border: 1px solid #E6E6E3; border-radius: 15px;
}
QFrame#topicChip:hover { border-color: #C2C2BC; }
QLabel#topicChipName { font-size: 13px; font-weight: 500; color: #2E2E2C; }
QPushButton#topicChipClose {
    background: transparent; border: none; border-radius: 9px;
    color: #B8B8B3; font-size: 13px; padding: 0 6px;
}
QPushButton#topicChipClose:hover { color: #B04A50; }
QLabel#sectionMeta { color: #ABABA6; font-size: 12px; }
QLabel#insightSite { color: #ABABA6; font-size: 12px; }

/* ---- 详情分区卡片与行式链接 ---- */
QFrame#detailCard { background: #FFFFFF; border: 1px solid #E6E6E3; border-radius: 16px; }
QFrame#linkRow { background: #FDFDFC; border: 1px solid #E6E6E3; border-radius: 10px; }
QFrame#linkRow:hover { border-color: #ABABA6; background: #FFFFFF; }
QLabel#linkRowSite {
    background: #F2F2F0; color: #7C7C76;
    border-radius: 8px; padding: 2px 8px;
    font-size: 11px; font-weight: 600;
}
QLabel#linkRowTitle { color: #2E2E2C; font-size: 13px; }
QLabel#linkRowArrow { color: #ABABA6; font-size: 13px; }

/* ---- 通用按钮 ---- */
QPushButton#secondaryButton {
    background: #FFFFFF; color: #2E2E2C;
    border: 1px solid #D8D8D4; border-radius: 14px;
    padding: 8px 18px; font-size: 13px; font-weight: 500;
}
QPushButton#secondaryButton:hover { border-color: #ABABA6; }
QPushButton#secondaryButton:disabled { color: #B5B5B0; border-color: #E8E8E5; }
QPushButton#primaryButton {
    background: #333331; color: #FDFDFC;
    border: none; border-radius: 14px;
    padding: 8px 18px; font-size: 13px; font-weight: 600;
}
QPushButton#primaryButton:hover { background: #45453F; }
QPushButton#primaryButton:disabled { background: #CFCFCB; }
QPushButton#ghostButton {
    background: transparent; color: #8A8A86;
    border: none; border-radius: 12px;
    padding: 6px 12px; font-size: 13px;
}
QPushButton#ghostButton:hover { color: #2E2E2C; }

/* ---- 第二层：历史行卡片（白） ---- */
QFrame#historyRow {
    background: #FFFFFF;
    border: 1px solid #E6E6E3;
    border-radius: 16px;
}
QFrame#historyRow:hover { border: 1px solid #C2C2BC; }
QLabel#historyQuery { font-size: 14px; font-weight: 500; color: #2E2E2C; }
QLabel#historyMeta { color: #ABABA6; font-size: 12px; }
QLabel#historyBadge {
    background: #F2F2F0; color: #7C7C76;
    border-radius: 10px; padding: 3px 10px;
    font-size: 11px; font-weight: 500;
}

/* ---- 历史主从分栏 ---- */
#historyPanel { background: #F7F7F5; border: 1px solid #E6E6E3; border-radius: 16px; }
QFrame#histItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
}
QFrame#histItem:hover { background: #EFEFEC; }
QFrame#histItem[selected="true"] { background: #333331; }
QLabel#histItemQuery { font-size: 13px; font-weight: 600; color: #2E2E2C; }
QLabel#histItemMeta { color: #ABABA6; font-size: 11px; }
QPushButton#histItemDelete {
    background: transparent; border: none; border-radius: 8px;
    color: #B8B8B3; font-size: 12px;
}
QPushButton#histItemDelete:hover { color: #B04A50; }

/* ---- 设置 ---- */
QLabel#settingsSectionTitle { font-size: 20px; font-weight: 300; color: #2E2E2C; }
QLabel#settingsSectionDesc { color: #ABABA6; font-size: 12px; }
QFrame#settingsGroup {
    background: #FFFFFF;
    border: 1px solid #E6E6E3;
    border-radius: 16px;
}
QLabel#groupTitle { font-size: 14px; font-weight: 500; color: #2E2E2C; }
QLabel#fieldLabel { color: #55554F; font-size: 13px; }
QLabel#testResultOk { color: #2E8E56; font-size: 12px; font-weight: 500; }
QLabel#testResultBad { color: #B04A50; font-size: 12px; font-weight: 500; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #DCDCD8;
    border-radius: 12px;
    padding: 7px 12px;
    color: #2E2E2C;
    font-size: 13px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #C9C9C4; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #ABABA6; }
QLineEdit[echoMode="2"] { letter-spacing: 2px; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background: #FDFDFC;
    border: 1px solid #DCDCD8;
    border-radius: 12px;
    selection-background-color: #EFEFED;
    selection-color: #2E2E2C;
}
QCheckBox { color: #3A3A36; font-size: 13px; spacing: 8px; }
QCheckBox::indicator {
    width: 17px; height: 17px;
    border: 1px solid #C9C9C4;
    border-radius: 6px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover { border-color: #ABABA6; }
QCheckBox::indicator:checked { background: #333331; border-color: #333331; }

/* ---- 滚动与进度 ---- */
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #D6D6D1; border-radius: 4px; min-height: 44px; }
QScrollBar::handle:vertical:hover { background: #BCBCB6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 0; }
QProgressBar {
    border: none;
    background: #E4E4E1;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background: #333331; border-radius: 3px; }

/* ---- AI 周报（全页文档） ---- */
QTextBrowser#weeklyBody {
    background: #FFFFFF;
    border: 1px solid #E6E6E3;
    border-radius: 14px;
    font-size: 15px;
    color: #2E2E2C;
    padding: 26px 30px;
}

